<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulatingoperationsofarentacarcompany_final.zedni.U5g6_MaintenanceHistoryController">
    <children>
        <Label layoutX="30.0" layoutY="30.0" text="Vehicle ID" />
        <TextField fx:id="vehicleIdTF" layoutX="150.0" layoutY="26.0" />
        <Button layoutX="350.0" layoutY="26.0" mnemonicParsing="false" onAction="#searchHistoryButtonOnAction" text="Search History" />
        <TableView fx:id="historyTableView" layoutX="30.0" layoutY="80.0" prefHeight="280.0" prefWidth="590.0">
            <columns>
                <TableColumn fx:id="dateTC" prefWidth="150.0" text="Date" />
                <TableColumn fx:id="serviceTypeTC" prefWidth="200.0" text="Service Type" />
                <TableColumn fx:id="costTC" prefWidth="150.0" text="Cost" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
