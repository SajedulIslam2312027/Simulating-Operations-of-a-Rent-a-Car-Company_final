<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="dashboardBorderPane" prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulatingoperationsofarentacarcompany_final.zedni.InventoryManagerDashboardController">

    <left>
        <VBox prefWidth="180.0" spacing="5" style="-fx-background-color: purple;">

            <children>

                <Button mnemonicParsing="false" onAction="#addPartOnAction" prefWidth="180.0" text="Add Part" />

                <Button mnemonicParsing="false" onAction="#processPartsRequestOnAction" prefWidth="180.0" text="Process Parts Request" />

                <Button mnemonicParsing="false" onAction="#lowStockOnAction" prefWidth="180.0" text="Low Stock" />

                <Button mnemonicParsing="false" onAction="#expiryManageOnAction" prefWidth="180.0" text="Expiry Management" />

                <Button mnemonicParsing="false" onAction="#partsCatalogueSearchOnAction" prefWidth="180.0" text="Parts Catalogue Search" />

                <Button mnemonicParsing="false" onAction="#supplierUpdateOnAction" prefWidth="180.0" text="Supplier Update" />

                <Button mnemonicParsing="false" onAction="#partsUsageReportOnAction" prefWidth="180.0" text="Parts Usage Report" />

                <Button mnemonicParsing="false" onAction="#physicalAuditOnAction" prefWidth="180.0" text="Physical Audit" />

                <Button mnemonicParsing="false" onAction="#logoutButtonOnAction" prefWidth="180.0" text="Logout" />

            </children>

        </VBox>
    </left>

    <center>
        <AnchorPane BorderPane.alignment="CENTER" />
    </center>

</BorderPane>
