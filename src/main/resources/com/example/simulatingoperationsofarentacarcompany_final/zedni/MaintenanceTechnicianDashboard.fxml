<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="dashboardBorderPane" prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulatingoperationsofarentacarcompany_final.zedni.MaintenanceTechnicianDashboardController">

    <left>
        <VBox prefWidth="180.0" spacing="5" style="-fx-background-color: purple;">

            <children>

                <Button mnemonicParsing="false" onAction="#assignedTasksOnAction" prefWidth="180.0" text="Assigned Tasks" />

                <Button mnemonicParsing="false" onAction="#jobStatusUpdateOnAction" prefWidth="180.0" text="Job Status Update" />

                <Button mnemonicParsing="false" onAction="#cleaningReportOnAction" prefWidth="180.0" text="Cleaning Report" />

                <Button mnemonicParsing="false" onAction="#partsRequestOnAction" prefWidth="180.0" text="Parts Request" />

                <Button mnemonicParsing="false" onAction="#inspectionOnAction" prefWidth="180.0" text="Inspection" />

                <Button mnemonicParsing="false" onAction="#maintenanceHistoryOnAction" prefWidth="180.0" text="Maintenance History" />

                <Button mnemonicParsing="false" onAction="#flagUnfitOnAction" prefWidth="180.0" text="Flag Unfit" />

                <Button mnemonicParsing="false" onAction="#dailySummaryOnAction" prefWidth="180.0" text="Daily Summary" />

                <Button mnemonicParsing="false" onAction="#logoutButtonOnAction" prefWidth="180.0" text="Logout" />

            </children>

        </VBox>
    </left>

    <center>
        <AnchorPane BorderPane.alignment="CENTER" />
    </center>

</BorderPane>
