<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="dashboardBorderPane"
            prefHeight="550.0"
            prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.simulatingoperationsofarentacarcompany_final.zedni.MaintenanceTechnicianDashboardController">

    <left>
        <VBox prefWidth="180.0"
              spacing="5"
              style="-fx-background-color: lightgray;">

            <children>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Assigned Tasks"
                        onAction="#assignedTasksOnAction"/>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Job Status Update"
                        onAction="#jobStatusUpdateOnAction"/>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Cleaning Report"
                        onAction="#cleaningReportOnAction"/>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Parts Request"
                        onAction="#partsRequestOnAction"/>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Inspection"
                        onAction="#inspectionOnAction"/>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Maintenance History"
                        onAction="#maintenanceHistoryOnAction"/>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Flag Unfit"
                        onAction="#flagUnfitOnAction"/>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Daily Summary"
                        onAction="#dailySummaryOnAction"/>

                <Button mnemonicParsing="false"
                        prefWidth="180.0"
                        text="Logout"
                        onAction="#logoutButtonOnAction"/>

            </children>

        </VBox>
    </left>

    <center>
        <AnchorPane BorderPane.alignment="CENTER"/>
    </center>

</BorderPane>