<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulatingoperationsofarentacarcompany_final.zedni.U5g1_AssignedTasksController">
    <children>
        <TableView fx:id="taskTableView" layoutX="30.0" layoutY="30.0" prefHeight="300.0" prefWidth="590.0">
            <columns>
                <TableColumn fx:id="taskIdTC" prefWidth="140.0" text="Task ID" />
                <TableColumn fx:id="vehicleIdTC" prefWidth="150.0" text="Vehicle ID" />
                <TableColumn fx:id="priorityTC" prefWidth="150.0" text="Priority" />
                <TableColumn fx:id="deadlineTC" prefWidth="150.0" text="Deadline" />
            </columns>
        </TableView>
        <Button layoutX="30.0" layoutY="350.0" mnemonicParsing="false" onAction="#viewTaskButtonOnAction" text="View Task Details" />
    </children>
</AnchorPane>