<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.simulatingoperationsofarentacarcompany_final.Sajedul.U2g1_VehicleAddController"
            prefHeight="400.0" prefWidth="500.0">
    <children>
        <Label layoutX="40.0" layoutY="30.0" text="Make" />
        <TextField fx:id="makeTF" layoutX="140.0" layoutY="26.0" />

        <Label layoutX="40.0" layoutY="70.0" text="Model" />
        <TextField fx:id="modelTF" layoutX="140.0" layoutY="66.0" />

        <Label layoutX="40.0" layoutY="110.0" text="Year" />
        <TextField fx:id="yearTF" layoutX="140.0" layoutY="106.0" />

        <Label layoutX="40.0" layoutY="150.0" text="Colour" />
        <TextField fx:id="colourTF" layoutX="140.0" layoutY="146.0" />

        <Label layoutX="40.0" layoutY="190.0" text="Plate No" />
        <TextField fx:id="plateTF" layoutX="140.0" layoutY="186.0" />

        <Button layoutX="140.0" layoutY="230.0" mnemonicParsing="false" onAction="#addVehicleButtonOnAction" text="Add Vehicle" />
    </children>
</AnchorPane>