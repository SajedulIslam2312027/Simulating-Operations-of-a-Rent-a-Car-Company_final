<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="462.0" prefWidth="660.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulatingoperationsofarentacarcompany_final.Sajedul.U1g2_CarSearchController">
    <children>
        <Label layoutX="40.0" layoutY="30.0" text="Location" />
        <TextField fx:id="locationTF" layoutX="140.0" layoutY="26.0" />

        <Label layoutX="40.0" layoutY="70.0" text="Start Date" />
        <DatePicker fx:id="startDateDP" layoutX="140.0" layoutY="66.0" />

        <Label layoutX="40.0" layoutY="110.0" text="End Date" />
        <DatePicker fx:id="endDateDP" layoutX="140.0" layoutY="106.0" />

        <Button layoutX="140.0" layoutY="150.0" mnemonicParsing="false" onAction="#searchButtonOnAction" text="Search Available Cars" />

        <TableView fx:id="carTableView" layoutX="40.0" layoutY="200.0" prefHeight="220.0" prefWidth="620.0">
            <columns>
                <TableColumn fx:id="idTC" prefWidth="156.0" text="Vehicle ID" />
                <TableColumn fx:id="modelTC" prefWidth="160.0" text="Model" />
                <TableColumn fx:id="statusTC" prefWidth="153.0" text="Status" />
                <TableColumn fx:id="rateTC" prefWidth="150.0" text="Daily Rate" />
            </columns>
        </TableView>

        <Button layoutX="63.0" layoutY="426.0" mnemonicParsing="false" onAction="#bookButtonOnAction" text="Book Selected Car" />
    </children>
</AnchorPane>
