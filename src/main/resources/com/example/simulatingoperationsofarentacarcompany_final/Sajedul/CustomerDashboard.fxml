<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="customerBorderpane"
            prefHeight="550.0"
            prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.simulatingoperationsofarentacarcompany_final.Sajedul.CustomerDashboardController">

    <left>
        <VBox prefWidth="170.0"
              style="-fx-background-color: lightgray;">

            <children>

                <Button mnemonicParsing="false"
                        onAction="#registerButtonOnAction"
                        prefWidth="170.0"
                        text="Register"/>

                <Button mnemonicParsing="false"
                        onAction="#searchButtonOnAction"
                        prefWidth="170.0"
                        text="Search Cars"/>

                <Button mnemonicParsing="false"
                        onAction="#bookingButtonOnAction"
                        prefWidth="170.0"
                        text="Book Car"/>

                <Button mnemonicParsing="false"
                        onAction="#paymentButtonOnAction"
                        prefWidth="170.0"
                        text="Payment"/>

                <Button mnemonicParsing="false"
                        onAction="#manageButtonOnAction"
                        prefWidth="170.0"
                        text="Manage Booking"/>

                <Button mnemonicParsing="false"
                        onAction="#roadsideButtonOnAction"
                        prefWidth="170.0"
                        text="Roadside Assistance"/>

                <Button mnemonicParsing="false"
                        onAction="#historyButtonOnAction"
                        prefWidth="170.0"
                        text="Rental History"/>

                <Button mnemonicParsing="false"
                        onAction="#reviewButtonOnAction"
                        prefWidth="170.0"
                        text="Submit Review"/>

                <Button mnemonicParsing="false"
                        onAction="#logoutButtonOnAction"
                        prefWidth="170.0"
                        text="Logout"/>

            </children>
        </VBox>
    </left>

    <center>
        <VBox/>
    </center>

</BorderPane>