<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.simulatingoperationsofarentacarcompany_final.Sajedul.U1g6_RoadsideAssistanceController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <Label layoutX="40.0" layoutY="30.0" text="Issue Type" />
        <ComboBox fx:id="issueTypeCB" layoutX="180.0" layoutY="26.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="70.0" text="Location" />
        <TextField fx:id="locationTF" layoutX="180.0" layoutY="66.0" />

        <Label layoutX="40.0" layoutY="110.0" text="Description" />
        <TextArea fx:id="descriptionTA" layoutX="180.0" layoutY="106.0" prefHeight="80.0" prefWidth="220.0" />

        <Button layoutX="180.0" layoutY="210.0" mnemonicParsing="false" onAction="#requestAssistanceButtonOnAction" text="Request Assistance" />
    </children>
</AnchorPane>