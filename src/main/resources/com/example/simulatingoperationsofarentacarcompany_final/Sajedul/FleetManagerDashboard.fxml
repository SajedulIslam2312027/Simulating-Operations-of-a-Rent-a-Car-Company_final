<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="fleetBorderpane"
            prefHeight="550.0"
            prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.simulatingoperationsofarentacarcompany_final.Sajedul.FleetManagerDashboardController">

    <left>
        <VBox prefWidth="170.0">

            <children>

                <Button mnemonicParsing="false"
                        onAction="#addVehicleButtonOnAction"
                        prefWidth="170.0"
                        text="Add Vehicle"/>

                <Button mnemonicParsing="false"
                        onAction="#maintenanceButtonOnAction"
                        prefWidth="170.0"
                        text="Schedule Maintenance"/>

                <Button mnemonicParsing="false"
                        onAction="#statusButtonOnAction"
                        prefWidth="170.0"
                        text="Update Status"/>

                <Button mnemonicParsing="false"
                        onAction="#trackingButtonOnAction"
                        prefWidth="170.0"
                        text="Fleet Tracking"/>

                <Button mnemonicParsing="false"
                        onAction="#reportButtonOnAction"
                        prefWidth="170.0"
                        text="Utilisation Report"/>

                <Button mnemonicParsing="false"
                        onAction="#fuelLogButtonOnAction"
                        prefWidth="170.0"
                        text="Fuel Log"/>

                <Button mnemonicParsing="false"
                        onAction="#damageButtonOnAction"
                        prefWidth="170.0"
                        text="Damage Report"/>

                <Button mnemonicParsing="false"
                        onAction="#retireButtonOnAction"
                        prefWidth="170.0"
                        text="Retire Vehicle"/>

                <Button mnemonicParsing="false"
                        onAction="#logoutButtonOnAction"
                        prefWidth="170.0"
                        text="Logout"/>

            </children>
        </VBox>
    </left>

    <center>
        <VBox/>
    </center>

</BorderPane>